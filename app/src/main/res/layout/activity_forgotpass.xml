<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- Nút quay lại -->

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:contentDescription="Quay lại"
        android:src="@drawable/ic_back"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@android:color/white">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="16dp"
            android:gravity="left"
            android:text="Quên mật khẩu"
            android:textColor="#444"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_margin="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFF0F0"
            android:layout_margin="16dp"

            >
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu? Đừng lo, nhập email của bạn để đặt lại mật khẩu hiện tại."
                android:textSize="14sp"
                android:textColor="#777777"
                />

            <EditText
                android:id="@+id/edtEmailqmk"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email"
                android:background="@android:color/white"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:elevation="2dp"/>



            <Button
                android:id="@+id/btnGuima"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Gửi mã"
                android:backgroundTint="#FF6666"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <LinearLayout
                android:layout_width="292dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRegisterchu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Nếu bạn chưa có tài khoản. "
                    android:textColor="#F444"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Đăng ký"
                    android:textColor="#FF6666"
                    android:textSize="14sp" />
            </LinearLayout>



        </LinearLayout>
    </LinearLayout>


</LinearLayout>
