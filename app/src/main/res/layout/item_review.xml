<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/review_user_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Ảnh người dùng"
        android:scaleType="centerCrop"
        android:src="@drawable/img_2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/review_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trần Tuệ Minh"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RatingBar
            android:id="@+id/review_rating_bar"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:numStars="5"
            android:progressTint="#FFC107"
            android:rating="4.0"
            android:secondaryProgressTint="#FFC107" />

        <TextView
            android:id="@+id/comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Phải công nhận là Mắt Biếc hay, đọc mà mình cứ ám ảnh mãi..."
            android:textColor="#000000"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>