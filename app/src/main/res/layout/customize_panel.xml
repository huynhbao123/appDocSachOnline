<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customizePanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:visibility="gone">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TÙY CHỈNH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:paddingBottom="8dp" />

    <!-- Màu nền -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Màu nền"
        android:textSize="14sp"
        android:textColor="#000000"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/colorBlack"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#000000"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/colorGreen"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#00FF00"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/colorYellow"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#FFFFCC"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/colorPink"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#FF99CC"
            android:layout_marginEnd="4dp" />

        <View
            android:id="@+id/colorBlue"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="#99CCFF" />
    </LinearLayout>

    <!-- Font chữ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Font chữ"
        android:textSize="14sp"
        android:textColor="#000000"
        android:paddingBottom="4dp" />

    <Spinner
        android:id="@+id/fontSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp" />

    <!-- Font chữ (cỡ chữ) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Font chữ"
        android:textSize="14sp"
        android:textColor="#000000"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/decreaseFontSizeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Decrease Font Size" />

        <TextView
            android:id="@+id/fontSizeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="16px"
            android:textSize="14sp"
            android:textColor="#000000" />

        <ImageButton
            android:id="@+id/increaseFontSizeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Increase Font Size" />
    </LinearLayout>

    <!-- Căn lề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Căn lề"
        android:textSize="14sp"
        android:textColor="#000000"
        android:paddingBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/decreaseMarginButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Decrease Margin" />

        <TextView
            android:id="@+id/marginText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="0px"
            android:textSize="14sp"
            android:textColor="#000000" />

        <ImageButton
            android:id="@+id/increaseMarginButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="Increase Margin" />
    </LinearLayout>
</LinearLayout>